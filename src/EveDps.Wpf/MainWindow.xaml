<Window x:Class="EveDps.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Eve DPS" Width="300" SizeToContent="Height"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" ResizeMode="NoResize"
        ShowActivated="False">
    <Window.Resources>
        <!-- Phase 6: minimal chrome for the HUD cycle buttons — transparent
             background, 1 px light border, border-only hover feedback. -->
        <Style x:Key="HudButton" TargetType="{x:Type Button}">
            <Setter Property="Foreground" Value="#68707c" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Padding" Value="4,0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="Chrome"
                                Background="{TemplateBinding Background}"
                                BorderBrush="#4DFFFFFF" BorderThickness="1"
                                CornerRadius="3" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="#80FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="#B3FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Border x:Name="Root" CornerRadius="10" Background="#C0101418" Padding="14,8">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <TextBlock x:Name="TitleText"
                           Text="EVE DPS" FontSize="10" FontWeight="SemiBold"
                           Foreground="#68707c" HorizontalAlignment="Left" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="PrimaryButton" Style="{StaticResource HudButton}"
                            ToolTip="Primary DPS window (click to cycle 5/15/60)" />
                    <Button x:Name="OpacityButton" Style="{StaticResource HudButton}"
                            Margin="4,0,0,0"
                            ToolTip="HUD opacity (click to cycle)" />
                </StackPanel>
            </Grid>

            <!-- Phase 8 compact layout amendment: OUT and IN share one row
                 (left / right-aligned pair, reduced font), freeing vertical
                 room for the attackers panel. -->
            <Grid Grid.Row="1" Margin="0,2,0,0">
                <TextBlock x:Name="OutText"
                           Text="OUT — dps" FontSize="16" FontWeight="Bold"
                           Foreground="#66d9ff" HorizontalAlignment="Left" />
                <TextBlock x:Name="InText"
                           Text="IN 0 dps" FontSize="16" FontWeight="Bold"
                           Foreground="#ff6b6b" HorizontalAlignment="Right" />
            </Grid>

            <!-- Phase 5: outgoing damage-type bar. Outgoing only — incoming
                 log lines carry no weapon name, so IN can't be attributed. -->
            <Grid Grid.Row="2" Height="9" Margin="0,3,0,0" IsHitTestVisible="True">
                <Border x:Name="TypeBarEmpty" CornerRadius="3"
                        Background="#3A414B" Visibility="Visible" />
                <Grid x:Name="TypeBarSegs" SizeChanged="TypeBar_SizeChanged">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition x:Name="ColEm" Width="1*" />
                        <ColumnDefinition x:Name="ColThermal" Width="1*" />
                        <ColumnDefinition x:Name="ColKinetic" Width="1*" />
                        <ColumnDefinition x:Name="ColExplosive" Width="1*" />
                        <ColumnDefinition x:Name="ColUnknown" Width="1*" />
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" x:Name="SegEm" Background="#4d7cff">
                        <TextBlock x:Name="EmLabel" FontSize="8" FontWeight="SemiBold"
                                   Foreground="#bfd2ff" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <Border Grid.Column="1" x:Name="SegThermal" Background="#ff5a4e">
                        <TextBlock x:Name="ThermalLabel" FontSize="8" FontWeight="SemiBold"
                                   Foreground="#ffc9c4" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <Border Grid.Column="2" x:Name="SegKinetic" Background="#9aa3ad">
                        <TextBlock x:Name="KineticLabel" FontSize="8" FontWeight="SemiBold"
                                   Foreground="#dde2e8" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <Border Grid.Column="3" x:Name="SegExplosive" Background="#ff9854">
                        <TextBlock x:Name="ExplosiveLabel" FontSize="8" FontWeight="SemiBold"
                                   Foreground="#ffd8b4" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <Border Grid.Column="4" x:Name="SegUnknown" Background="#565d66">
                        <TextBlock x:Name="UnknownLabel" FontSize="8" FontWeight="SemiBold"
                                   Foreground="#a7adb5" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                </Grid>
            </Grid>

            <!-- Phase 8: incoming attackers panel — up to five rows, filled
                 in code from phase 7 snapshot rows; empty = collapsed so the
                 HUD never blocks view when idle. -->
            <StackPanel Grid.Row="3" x:Name="AttackerRows" Margin="0,3,0,0" />

            <TextBlock Grid.Row="4" x:Name="StatusText"
                       Text="waiting for combat…" FontSize="10"
                       Foreground="#68707c" VerticalAlignment="Bottom" />
        </Grid>
    </Border>
</Window>
