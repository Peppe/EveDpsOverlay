<Window x:Class="EveDps.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Eve DPS" Width="300" SizeToContent="Height"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" ResizeMode="NoResize"
        ShowActivated="False">
    <Window.Resources>
        <!-- Phase 6: minimal chrome for the HUD cycle buttons — transparent
             background, 1 px light border, border-only hover feedback. -->
        <Style x:Key="HudButton" TargetType="{x:Type Button}">
            <Setter Property="Foreground" Value="#68707c" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Padding" Value="4,0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="Chrome"
                                Background="{TemplateBinding Background}"
                                BorderBrush="#4DFFFFFF" BorderThickness="1"
                                CornerRadius="3" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="#80FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="#B3FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Border x:Name="Root" CornerRadius="10" Background="#C0101418" Padding="14,8">
        <Grid>
            <Grid.RowDefinitions>
                <!-- Phase 13: three rows — title chrome, the panel area
                     (each panel carries its own big number header), and
                     the status line. The shared number row and both
                     full-width type bars are gone. Phase 14 adds the
                     static damage-type legend row between them. -->
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <TextBlock x:Name="TitleText"
                           Text="EVE DPS" FontSize="10" FontWeight="SemiBold"
                           Foreground="#68707c" HorizontalAlignment="Left" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="PrimaryButton" Style="{StaticResource HudButton}"
                            ToolTip="Primary DPS window (click to cycle 5/15/60)" />
                    <Button x:Name="OpacityButton" Style="{StaticResource HudButton}"
                            Margin="4,0,0,0"
                            ToolTip="HUD opacity (click to cycle)" />
                    <!-- Phase 12: layout toggle — shows the icon of the layout
                         clicking it will switch TO (↕ = go vertical). -->
                    <Button x:Name="LayoutButton" Style="{StaticResource HudButton}"
                            Margin="4,0,0,0"
                            ToolTip="Layout (click to toggle horizontal/vertical)" />
                    <!-- Phase 14: legend visibility toggle. State-colored
                         "Le" (bright = legend shown, dim = hidden). -->
                    <Button x:Name="LegendButton" Style="{StaticResource HudButton}"
                            Margin="4,0,0,0"
                            ToolTip="Damage-type legend (click to hide/show)" />
                    <!-- Phase 15: height stability toggle. Shows the row
                         mode: "A" = auto (hug content, dim), "5R" =
                         reserve five row slots (bright). -->
                    <Button x:Name="ReserveButton" Style="{StaticResource HudButton}"
                            Margin="4,0,0,0"
                            ToolTip="Row space (click to toggle): auto = hug content, 5R = reserve 5 rows (no window jumping)" />
                </StackPanel>
            </Grid>

            <!-- Phase 13: the big OUT/IN dps numbers moved into the panels
                  as their header rows (replacing the small gray captions).
                  The shared number row, the vertical number stack, and both
                  full-width type bars are removed; alignment no longer
                  switches per layout because the headers live inside the
                  panels. -->
            <!-- Phase 11/12: the two source panels share one layout area so
                 the toggle can restack them: horizontal = side-by-side
                 halves (columns), vertical = stacked full-width (rows).
                 Column/row definitions are rebuilt in ApplyLayout(). -->
            <Grid Grid.Row="1" x:Name="PanelArea" Margin="0,3,0,0">
                <StackPanel x:Name="OutPanel">
                    <TextBlock x:Name="OutText"
                               Text="OUT — dps" FontSize="16" FontWeight="Bold"
                               Foreground="#66d9ff" HorizontalAlignment="Left"
                               Margin="1,0,0,1" />
                    <StackPanel x:Name="OutRows" />
                </StackPanel>

                <StackPanel x:Name="InPanel">
                    <TextBlock x:Name="InText"
                               Text="IN 0 dps" FontSize="16" FontWeight="Bold"
                               Foreground="#ff6b6b" HorizontalAlignment="Right"
                               Margin="0,0,1,1" />
                    <StackPanel x:Name="AttackerRows" />
                </StackPanel>
            </Grid>

            <!-- Phase 14: static damage-type legend — a pure color key.
                 Five EQUAL segments, always all visible (never bound to
                 snapshot data), one per type in DamageTypes.All order,
                 using the exact row-bar colors so the tiny per-row
                 segments are decodable. Labels use the old bar-label
                 text colors. Hidden via the title-row toggle. -->
            <Grid Grid.Row="2" x:Name="LegendRow" Height="9" Margin="0,3,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1*" />
                    <ColumnDefinition Width="1*" />
                    <ColumnDefinition Width="1*" />
                    <ColumnDefinition Width="1*" />
                    <ColumnDefinition Width="1*" />
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Background="#4d7cff" CornerRadius="3,0,0,3">
                    <TextBlock Text="EM" FontSize="8" FontWeight="SemiBold" Foreground="#bfd2ff"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <Border Grid.Column="1" Background="#ff5a4e">
                    <TextBlock Text="TH" FontSize="8" FontWeight="SemiBold" Foreground="#ffc9c4"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <Border Grid.Column="2" Background="#9aa3ad">
                    <TextBlock Text="KIN" FontSize="8" FontWeight="SemiBold" Foreground="#dde2e8"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <Border Grid.Column="3" Background="#ff9854">
                    <TextBlock Text="EXP" FontSize="8" FontWeight="SemiBold" Foreground="#ffd8b4"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <Border Grid.Column="4" Background="#565d66" CornerRadius="0,3,3,0">
                    <TextBlock Text="UNK" FontSize="8" FontWeight="SemiBold" Foreground="#a7adb5"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
            </Grid>

            <TextBlock Grid.Row="3" x:Name="StatusText"
                       Text="waiting for combat…" FontSize="10" TextWrapping="Wrap"
                       Foreground="#68707c" VerticalAlignment="Bottom" />
        </Grid>
    </Border>
</Window>
